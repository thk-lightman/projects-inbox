# =============================================================================
# Identity-Engine v1.0 — 2-API 인증 분기 (TTS는 Anki AwesomeTTS가 담당)
# 참조: assetTools-GCP-auth.md → CASE: Identity-Engine v1.0
# =============================================================================

# ── 1. Gemini (번역 백엔드) ───────────────────────────────────────────────────
# 백엔드 2종 택1:
#   api → AI Studio API Key. 문장당 1콜. RPM/RPD 한도 작음.
#   cli → 공식 gemini CLI를 subprocess로 호출. OAuth 인증 → Google 계정 구독 쿼터 사용.
#         메가 배치(기본 100문장/콜) → 대량 처리 적합. 사전 `gemini auth login` 필요.
TRANSLATION_BACKEND=api

# API 백엔드용 키 (cli 모드면 빈 값 허용).
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# CLI 백엔드 옵션 (TRANSLATION_BACKEND=cli일 때만 의미 있음).
GEMINI_CLI_PATH=gemini
MEGA_BATCH_SIZE=50         # 1콜당 문장 수. 50~100 권장. 너무 크면 응답 잘림/지연
MEGA_PARALLEL=4            # 동시 실행 CLI 프로세스. 4~8 권장. RPM 한도 보고 조절
CLI_TIMEOUT=300

# Embedding / clustering 설정 (deterministic, no LLM).
# multilingual MiniLM (KR+EN 지원, 384-dim, ~120MB)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# cosine similarity threshold for cluster attachment (0.75~0.85 권장)
CLUSTER_THRESHOLD=0.78
EMBED_BATCH_SIZE=128       # sentence-transformer encode batch (CPU 적정)
LABEL_SAMPLE_SIZE=8        # LLM에게 cluster당 보내는 대표 문장 수

# 모델 교체 지점. 후보: gemini-3-flash-preview, gemini-3-pro-preview, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3-flash-preview

# ── 2. Google Cloud SA (Sheets 전용) ─────────────────────────────────────────
# ADC 우선순위 1: SDK가 자동 탐색.
# 발급:
#   gcloud services enable sheets.googleapis.com
#   gcloud iam service-accounts create identity-engine-bot
#   gcloud iam service-accounts keys create ~/.gcp/identity-engine-sa.json \
#     --iam-account="identity-engine-bot@$PROJECT_ID.iam.gserviceaccount.com"
#   chmod 600 ~/.gcp/identity-engine-sa.json
# 경로에 ${HOME} 등 변수 보간 사용 가능 (python-dotenv가 로드 시 치환). ~ 는 확장 안 됨.
GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.gcp/identity-engine-sa.json

# ── 3. Google Sheets ─────────────────────────────────────────────────────────
# 위 SA 이메일을 대상 스프레드시트에 "편집자"로 직접 공유해야 함 (IAM 아님).
GSPREAD_SPREADSHEET_ID=your_spreadsheet_id_here
GSPREAD_WORKSHEET_NAME=Identity-Engine

# ── Vault & Persona ──────────────────────────────────────────────────────────
VAULT_PATH=/Users/mori/Obsidian/Obsidian_Master_v2
PERSONA_PATH=01 Command Center/proj-EnglishIdentityTraniner/docs-Identity-Persona.md

# ── Anki ─────────────────────────────────────────────────────────────────────
# 음성은 Anki AwesomeTTS 애드온이 카드 필드에서 직접 생성 → 엔진은 텍스트만 push.
ANKICONNECT_URL=http://localhost:8765
ANKI_DECK_NAME=Identity::EnglishTrainer
ANKI_MODEL_NAME=Identity-Engine

# ── 처리 설정 ─────────────────────────────────────────────────────────────────
BATCH_SIZE=10
MAX_RETRIES=3
