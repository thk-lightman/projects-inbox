# util-autoresearch env — copy to .env (gitignored) and adjust.
# A안: single VAULT_ROOT + per-file vault-relative path overrides.
# Each *_REL is resolved under VAULT_ROOT. Unset/empty → script default shown below.

# --- shared ---
VAULT_ROOT=/Users/mori/Obsidian/Obsidian_Master_v2
OPENALEX_EMAIL=

# --- paper layer (fetch_papers.py) ---
AR_PAPER_WATCHLIST_LABS_REL=00 Get Things Done/03Inbox/auto-research/docs/docs-watchlist-labs.md
AR_PAPER_WATCHLIST_JOURNALS_REL=00 Get Things Done/03Inbox/auto-research/docs/docs-watchlist-journals.md
AR_PAPER_WATCHLIST_TOPICS_REL=00 Get Things Done/03Inbox/auto-research/docs/docs-watchlist-paper-topics.md
AR_PAPER_INBOX_REL=00 Get Things Done/03Inbox/auto-research/raws
AR_PAPER_INBOX_LIST_REL=00 Get Things Done/03Inbox/01Inbox-paper.md
AR_PAPER_BRIEFINGS_REL=00 Get Things Done/03Inbox/auto-research/briefings

# --- dev layer (fetch_dev.py) ---
AR_DEV_WATCHLIST_TOPICS_REL=00 Get Things Done/03Inbox/auto-research/docs/docs-watchlist-topics.md
AR_DEV_BRIEFINGS_REL=00 Get Things Done/03Inbox/auto-research/briefings
AR_DEV_SCRAP_REL=00 Get Things Done/03Inbox/01Inbox-scrap.md

# --- zotero push (zotero_save.py) ---
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_COLLECTION=
